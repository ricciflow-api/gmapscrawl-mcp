{
  "source": "https://gmapscrawl.com/skills/google-maps-data/references/operations.json",
  "tools": [
    {
      "name": "search_google_maps",
      "description": "Create one durable, billable Google Maps search request for one source page. The result may be asynchronous; use get_scrape_job and get_scrape_results with the returned job ID.",
      "scope": "scrapes:write",
      "request_units": 1,
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "example": "coffee shops in Seattle"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 1
          },
          "ll": {
            "type": "string",
            "pattern": "^@-?(?:90(?:\\.0+)?|(?:[0-8]?\\d)(?:\\.\\d+)?),-?(?:180(?:\\.0+)?|(?:1[0-7]\\d|\\d?\\d)(?:\\.\\d+)?),(?:[1-9]|1\\d|2[01])z$",
            "example": "@47.6062,-122.3321,12z"
          },
          "hl": {
            "type": "string",
            "default": "en",
            "example": "en"
          },
          "gl": {
            "type": "string",
            "pattern": "^[A-Za-z]{2}$",
            "example": "us"
          },
          "extra": {
            "type": "boolean",
            "default": false
          },
          "client_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "webhook_endpoint_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "client_request_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[\\x21-\\x7e]+$"
          }
        },
        "required": [
          "q",
          "client_request_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_google_maps_reviews",
      "description": "Create one durable, billable request for exactly one positive-int32 review source page, returning at most 10 reviews. Empty pages still consume one admitted unit.",
      "scope": "scrapes:write",
      "request_units": 1,
      "inputSchema": {
        "type": "object",
        "properties": {
          "fid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "example": "0x89c259af336b3341:0xa4969e07ce3108de"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "default": 1
          },
          "sort_by": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ],
            "default": 1
          },
          "client_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "webhook_endpoint_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "client_request_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[\\x21-\\x7e]+$"
          }
        },
        "required": [
          "fid",
          "client_request_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
